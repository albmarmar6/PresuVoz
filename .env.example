# =========================================================
# PresuVoz — Variables de Configuración de Entorno
# =========================================================

# Puerto del servidor local (cuando se active el webhook)
PORT=3000

# Claves de APIs de Inteligencia Artificial
# GEMINI_API_KEY es la variable principal para el backend Vercel (api/gemini.js)
# Obtén tu clave gratuita en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
# El proxy Gemini público está desactivado por defecto. No activarlo sin autenticación por usuario.
GEMINI_PROXY_ENABLED=false
# Debe ser el mismo secreto aleatorio (mínimo 32 caracteres) en el gateway y en Vercel.
PRESUVOZ_SIGNING_SECRET=pon_aqui_un_secreto_aleatorio_de_al_menos_32_caracteres
# Orígenes que alojan la página de firma y el simulador. Separa varios con comas.
PRESUVOZ_ALLOWED_ORIGINS=https://albmarmar6.github.io
# Registro de firmas atómico (Upstash Redis REST). Obligatorio para habilitar firma.
UPSTASH_REDIS_REST_URL=https://tu-base.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_rest_de_upstash
RESEND_FROM_EMAIL=PresuVoz <avisos@tu-dominio-verificado.es>
AI_TRANSCRIPTION_API_KEY=tu_clave_de_transcripcion_aqui

# Configuración WhatsApp (Proveedor: 'baileys' por QR o 'cloud_api' Oficial de Meta)
WHATSAPP_PROVIDER=cloud_api
META_PHONE_NUMBER_ID=tu_phone_number_id_de_meta
META_ACCESS_TOKEN=tu_access_token_de_meta
META_WEBHOOK_VERIFY_TOKEN=presuvoz_webhook_secreto_2026
META_APP_SECRET=tu_app_secret_de_meta_opcional
META_DISPLAY_PHONE_NUMBER=346XXXXXXXX

# Dominio propio para enlaces cortos de firma digital (ej. https://tudominio.es -> genera https://tudominio.es/f/Ab3xK9)
# Si se deja vacío, usa la URL clásica de GitHub Pages
PUBLIC_BASE_URL=

# Control de acceso estricto (Default-Deny en producción)
REQUIRE_EXPLICIT_AUTH=true
ADMIN_PHONE_NUMBERS=346XXXXXXXX
ALLOWED_NUMBERS=346XXXXXXXX

# Configuración de Correo Electrónico (Resend)
RESEND_API_KEY=re_tu_clave_resend_aqui

