# =========================================================
# PresuVoz — Variables de Configuración de Entorno
# =========================================================

# Puerto del servidor local (cuando se active el webhook)
PORT=3000

# Claves de APIs de Inteligencia Artificial
# GEMINI_API_KEY es la variable principal para el backend Vercel (api/gemini.js)
# Obtén tu clave gratuita en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aqui
AI_TRANSCRIPTION_API_KEY=tu_clave_de_transcripcion_aqui

# Configuración WhatsApp Business Cloud API / Gateway
WHATSAPP_API_TOKEN=tu_token_whatsapp_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_id_aqui
WHATSAPP_WEBHOOK_VERIFY_TOKEN=token_seguro_de_verificacion_webhook

# Configuración de Correo Certificado (SMTP / Resend / SendGrid)
SMTP_HOST=smtp.proveedor.com
SMTP_PORT=587
SMTP_USER=notificaciones@presuvoz.app
SMTP_PASS=tu_contraseña_smtp_aqui
